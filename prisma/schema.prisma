// ============================================================
// Prisma Schema - 白墨记账 Desktop
// ============================================================

generator client {
  provider = "prisma-client-rust"
  output   = "../src-tauri/src/prisma/_prisma.rs"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// 客户表
// ============================================================
model Customer {
  id           String   @id @default(uuid())
  name         String
  phone        String?
  address      String?
  balance      Float    @default(0)        // 余额
  creditLimit  Float    @default(0)        // 信用额度
  unitPrice    Float    @default(0)        // 单价（每平方单价，用于价格计算）
  notes        String?                     // 备注信息
  isActive     Boolean  @default(true)     // 是否激活
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 关联：一个客户可以有多个订单
  orders            Order[]             @relation("CustomerOrders")
  // 关联：一个客户可以有多个图案（可选，某些图案可能专属某客户）
  patterns          Pattern[]           @relation("CustomerPatterns")
  // 关联：一个客户可以有多个文件夹
  folders           PatternFolder[]     @relation("CustomerFolders")
  // 关联：一个客户可以有多个财务记录
  financialRecords  FinancialRecord[]   @relation("CustomerFinancialRecords")

  @@index([isActive])
  @@index([balance])
  @@map("customers")
}

// ============================================================
// 产品表
// ============================================================
model Product {
  id        String   @id @default(uuid())
  name      String   @unique
  price     Float
  unit      String   // 单位，如：个、件、箱
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联：一个产品可以在多个订单项中
  orderItems OrderItem[]

  @@map("products")
}

// ============================================================
// 订单表
// ============================================================
model Order {
  id             String    @id @default(uuid())
  customerId     String
  orderDate      DateTime  @default(now())
  totalAmount    Float
  isConfirmed    Boolean   @default(false) @map("is_confirmed") // 是否已确认并生产
  confirmedAt    DateTime? @map("confirmed_at") // 确认并生产时间
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // 关联：一个订单属于一个客户
  customer       Customer  @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  // 关联：一个订单可以有多个订单项
  items          OrderItem[]
  // 关联：一个订单可以有多个订单图案项（印花行业）
  patternItems     OrderPatternItem[]  @relation("OrderPatternItems")
  // 关联：一个订单可以有多个财务记录
  financialRecords FinancialRecord[]   @relation("OrderFinancialRecords")

  @@map("orders")
}

// ============================================================
// 订单项表
// ============================================================
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float    // 下单时的价格（快照，防止产品价格变动影响历史订单）
  subtotal  Float    // 小计 = quantity * price
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联：一个订单项属于一个订单
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // 关联：一个订单项对应一个产品
  product   Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ============================================================
// 图案文件夹表
// ============================================================
model PatternFolder {
  id         String         @id @default(uuid())
  name       String
  parentId   String?        @map("parent_id")
  level      Int            @default(0)
  path       String
  sortOrder  Int            @default(0) @map("sort_order")
  customerId String?        @map("customer_id")
  isSystem   Boolean        @default(false) @map("is_system")
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  customer   Customer?      @relation("CustomerFolders", fields: [customerId], references: [id], onDelete: Cascade)
  parent     PatternFolder? @relation("FolderHierarchy", fields: [parentId], references: [id])
  children   PatternFolder[] @relation("FolderHierarchy")
  patterns   Pattern[]

  @@map("pattern_folders")
}

// ============================================================
// 图案颜色变体表
// ============================================================
model PatternColor {
  id        String   @id @default(uuid())
  patternId String   @map("pattern_id")
  name      String
  color     String   @default("#000000")
  image     String?
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pattern        Pattern          @relation(fields: [patternId], references: [id], onDelete: Cascade)
  orderPatterns  OrderPatternItem[]

  @@unique([patternId, name])
  @@map("pattern_colors")
}

// ============================================================
// 图案表（印花图案）
// ============================================================
model Pattern {
  id            String         @id @default(uuid())
  name          String
  code          String         @unique
  actualHeight  Float          // 实际高度（厘米）
  bleedHeight   Float          // 出血高度（厘米）
  unitsPerRow   Int            // 每行个数
  rowCount      Int            // 行数
  localFilePath String?        // 本地 TIFF 文件路径
  customerId    String?        // 关联客户（可选，某些图案可能专属某客户）
  folderId      String?        @map("folder_id")
  colorType     String         @default("SINGLE") @map("color_type")  // SINGLE, MULTI
  previewImage  String?        @map("preview_image")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 关联：一个图案可以属于一个客户（可选）
  customer       Customer?       @relation("CustomerPatterns", fields: [customerId], references: [id], onDelete: SetNull)
  // 关联：一个图案可以在多个订单图案项中
  orderItems     OrderPatternItem[] @relation("PatternOrderItems")
  // 关联：文件夹
  folder         PatternFolder?  @relation(fields: [folderId], references: [id])
  // 关联：颜色变体
  colorVariants  PatternColor[]

  @@index([folderId])
  @@map("patterns")
}

// ============================================================
// 订单图案项表（替代原 OrderItem，用于印花行业）
// ============================================================
model OrderPatternItem {
  id             String   @id @default(uuid())
  orderId        String
  patternId      String
  quantity       Int
  area           Float?   // 面积（平方米）
  pricingMode    String   // 计价模式：QUANTITY（按数量）或 AREA（按面积）
  unitPrice      Float    // 单价
  totalPrice     Float    // 小计
  colorVariantId String?  @map("color_variant_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // 关联：一个订单图案项属于一个订单
  order         Order        @relation("OrderPatternItems", fields: [orderId], references: [id], onDelete: Cascade)
  // 关联：一个订单图案项对应一个图案
  pattern       Pattern      @relation("PatternOrderItems", fields: [patternId], references: [id])
  // 关联：颜色变体
  colorVariant  PatternColor? @relation(fields: [colorVariantId], references: [id])
  // 关联：财务记录
  financialRecords FinancialRecord[]

  @@index([colorVariantId])
  @@map("order_pattern_items")
}

// ============================================================
// 财务记录表
// ============================================================
model FinancialRecord {
  id            String   @id @default(uuid())
  type          String   // PAYMENT, REFUND, ADJUSTMENT
  amount        Float
  description   String
  orderId       String?  @map("order_id")
  orderItemId   String?  @map("order_item_id")
  customerId    String   @map("customer_id")
  balanceBefore Float    @map("balance_before")
  balanceAfter  Float    @map("balance_after")
  operatorName  String   @map("operator_name")
  createdAt     DateTime @default(now()) @map("created_at")

  // 关联：财务记录属于一个客户
  customer   Customer          @relation("CustomerFinancialRecords", fields: [customerId], references: [id], onDelete: Cascade)
  // 关联：财务记录可能关联一个订单
  order      Order?            @relation("OrderFinancialRecords", fields: [orderId], references: [id])
  // 关联：财务记录可能关联一个订单项
  orderItem  OrderPatternItem? @relation(fields: [orderItemId], references: [id])

  @@map("financial_records")
}

// ============================================================
// 系统日志表
// ============================================================
model SystemLog {
  id           String    @id @default(uuid())
  level        String    // INFO, WARNING, ERROR
  message      String
  metadata     String?   // JSON字符串
  operatorName String?   @map("operator_name")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("system_logs")
}

// ============================================================
// 颜色预设表
// ============================================================
model ColorPreset {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String?  @map("display_name")
  color       String   @default("#000000")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("color_presets")
}

// ============================================================
// 应用配置表
// ============================================================
model AppConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("GENERAL")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_configs")
}
