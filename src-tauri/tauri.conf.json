{
  "$schema": "https://schema.tauri.app/config/2.0.json",
  "productName": "白墨记账",
  "version": "0.1.0",
  "identifier": "com.baimo.ledger",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "cd frontend && npm run build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "白墨记账系统",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Business",
    "shortDescription": "白墨记账系统桌面版",
    "longDescription": "专为印花行业打造的本地记账管理软件"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
